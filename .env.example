# ShaadiCount local configuration. Copy via `bash scripts/gen-env.sh` (generates random secrets) - never commit .env.
NODE_ENV=development
PORT=4000
# Local development database (matches docker-compose.yml). Use a managed secret store for any real environment.
DATABASE_URL=postgres://shaadicount:shaadicount_local_dev@localhost:5432/shaadicount_dev
LOG_LEVEL=info
WEB_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# REQUIRED in production (the API refuses to start without it). Number of reverse proxies between the internet and the API:
# browser -> Next.js -> API = 1; browser -> load balancer -> Next.js -> API = 2; API exposed directly = 0.
# Too low: all users share one rate-limit bucket (one client can block everyone). Too high: clients can spoof their IP.
TRUST_PROXY=0
# Interactive API docs (/docs, /v1/openapi.json). Defaults to on outside production and off in production.
# DOCS_ENABLED=false
# Optional separate key for opt-out suppression hashes (falls back to PSEUDONYM_SECRET). Set once; never rotate without re-hashing.
# SUPPRESSION_HASH_SECRET=
# Per-minute rate limits (defaults shown): per-user ceiling on authenticated routes, login per email-only.
# RATE_LIMIT_USER_PER_MIN=600
# RATE_LIMIT_LOGIN_EMAIL_PER_MIN=100

# Secrets (>= 32 chars). gen-env.sh fills these with random values.
CSRF_SECRET=
RSVP_TOKEN_SECRET=
PSEUDONYM_SECRET=
MESSAGING_WEBHOOK_SECRET=

# Messaging: the fake provider is the default. Live sending stays OFF; enabling it requires every LIVE_* value below
# plus a real provider adapter, approved templates and a consent/opt-out policy (see docs/messaging/provider-integration.md).
MESSAGING_MODE=fake
LIVE_MESSAGING_ENABLED=false
# LIVE_PROVIDER_NAME=
# LIVE_PROVIDER_CREDENTIALS_REF=
# LIVE_TEMPLATE_APPROVAL_REF=
# LIVE_CONSENT_POLICY_REF=
# LIVE_OPT_OUT_POLICY_REF=
# LIVE_SPEND_CAP_PAISE=
ENABLED_CHANNELS=whatsapp,sms,email
# Placeholder per-message estimates for the pre-send preview. NOT verified provider pricing.
MESSAGE_COST_PAISE_WHATSAPP=80
MESSAGE_COST_PAISE_SMS=25
MESSAGE_COST_PAISE_EMAIL=5
MESSAGE_RATE_PER_MINUTE_PER_WORKSPACE=120
WORKER_POLL_MS=2000
DELETION_GRACE_DAYS=7
