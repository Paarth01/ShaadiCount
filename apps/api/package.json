{
  "name": "@shaadicount/api",
  "version": "0.1.0",
  "private": true,
  "description": "ShaadiCount NestJS modular-monolith API and worker",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "ts-node --transpile-only src/db/migrate-cli.ts",
    "db:seed": "ts-node --transpile-only src/db/seed.ts",
    "db:reset": "ts-node --transpile-only src/db/reset-cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "luxon": "^3.6.1",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.30.0",
    "jest": "^30.0.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.35.0"
  }
}
